# true（預設）＝用 src/mocks 的假資料；false＝打真的後端
VITE_USE_MOCK=true
# 後端網址；留空時走同網域的 /api（開發時由 Vite 轉給 localhost:8000，Docker 時由 nginx 轉）
VITE_API_BASE=
# 沉浸式新版（?exp=1）的 Google 地圖模式。沒設就只有路線示意圖，畫面會說明原因。
# 金鑰：Google Cloud 開 Maps JavaScript API（要綁帳單），建立「瀏覽器金鑰」並限制 HTTP 參照網址（例如 http://localhost:5173/*、正式網域）
VITE_GOOGLE_MAPS_KEY=
# 地圖 ID（編號標記需要 Advanced Markers）；留空用 Google 的 DEMO_MAP_ID，只適合開發
VITE_GOOGLE_MAPS_MAP_ID=
