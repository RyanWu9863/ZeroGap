# 複製成 .env 後修改。.env 不進版本控制。
# 完整清單見 app/config.py；時間規則、限流、額度的數字都可以用同名的大寫變數覆蓋。

# --- 連線（docker compose 內會自動改成服務名稱） ---
DATABASE_URL=postgresql+psycopg://zerogap:zerogap@localhost:5432/zerogap
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- 外部服務：金鑰到了再把 *_MODE 改成 real ---
TDX_MODE=mock
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
GOOGLE_MODE=mock
GOOGLE_PLACES_API_KEY=
JEV_MODE=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_TOP_PROBABILITY=0.6

# --- LLM 備援 ---
# ollama：本機或 compose 裡的 Ollama；mock：不呼叫，直接採用 Jev 機率最高的選項
LLM_MODE=ollama
# 在 Docker 裡連本機的 Ollama 用 host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
