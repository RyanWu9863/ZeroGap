# 複製成 .env 後修改。.env 不進版本控制。
# 完整清單見 app/config.py；時間規則、限流、額度的數字都可以用同名的大寫變數覆蓋。

# --- 連線（docker compose 內會自動改成服務名稱） ---
DATABASE_URL=postgresql+psycopg://zerogap:zerogap@localhost:5433/zerogap
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- 分享連結（規格書 6.8）---
# 網頁的網址：MCP 的 plan_date 會回傳 {這個網址}/p/{job_id}。沒填就不附連結。
# 本機 Demo 例如 http://localhost:5173
# 前端分享頁（第 4 批）做好前先不要填，否則連結會打不開
PUBLIC_WEB_BASE_URL=
# 排出來的結果保留幾秒（預設 7 天）
# SAVED_PLAN_TTL_SECONDS=604800
# Redis 記憶體用量超過 maxmemory 的這個比例，就不存分享用的行程（maxmemory 為 0 不檢查）
# SAVED_PLAN_MAX_MEMORY_RATIO=0.7

# --- 外部服務：金鑰到了再把 *_MODE 改成 real ---
TDX_MODE=mock
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
GOOGLE_MODE=mock
GOOGLE_PLACES_API_KEY=
JEV_MODE=mock
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_MIN_TOP_PROBABILITY=0.6
# 判斷 Jev 有沒有把握的方式：fixed（預設，最高機率 < 門檻）、options、margin、entropy
# ROUTER_PARAM 不填就用 JEV_MIN_TOP_PROBABILITY
# ROUTER_POLICY=fixed
# ROUTER_PARAM=

# --- LLM 備援 ---
# ollama：本機或 compose 裡的 Ollama；mock：不呼叫，直接採用 Jev 機率最高的選項
LLM_MODE=ollama
# 在 Docker 裡連本機的 Ollama 用 host.docker.internal
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
# LLM 可以回答「無法判斷」，這時採用 Jev 機率最高的選項
# LLM_ALLOW_ABSTAIN=false
# Ollama 熔斷狀態放 Redis，所有 worker 和規劃共用；false 是每次規劃各自計算
# LLM_BREAKER_SHARED=true
